<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Доска с кубами — чарлист</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:system-ui,-apple-system,sans-serif;background:#1a1a1a;color:#e0e0e0;overflow:hidden;height:100vh}
#toolbar{
  position:fixed;top:0;left:0;right:0;height:56px;
  background:#242424;border-bottom:1px solid #333;
  display:flex;align-items:center;gap:10px;padding:0 12px;
  z-index:10;flex-wrap:nowrap;overflow-x:auto;
}
#toolbar button{
  background:#d4a95a;color:#1a1a1a;border:none;padding:6px 12px;
  border-radius:4px;cursor:pointer;font-weight:bold;font-size:13px;white-space:nowrap;
}
#toolbar button:hover{background:#e0b96a}
#toolbar button.secondary{background:#444;color:#e0e0e0}
#toolbar button.secondary:hover{background:#555}
#toolbar input[type=number]{
  width:60px;background:#1a1a1a;color:#e0e0e0;border:1px solid #444;
  padding:5px 8px;border-radius:4px;font-size:13px;text-align:center;
}
#toolbar label{font-size:13px;color:#aaa}
.colors{display:flex;gap:4px}
.color-btn{
  width:26px;height:26px;border-radius:50%;cursor:pointer;
  border:2px solid #333;padding:0;
}
.color-btn.active{border-color:#fff;box-shadow:0 0 0 2px #d4a95a}
#board{
  position:absolute;top:56px;left:0;right:0;bottom:0;
  overflow:hidden;background:#111;
}
#drop-zone{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  color:#666;font-size:16px;pointer-events:none;text-align:center;padding:20px;
}
#drop-zone.dragover{color:#d4a95a;background:#1a1a1a}
#canvas-wrap{
  position:absolute;top:0;left:0;transform-origin:0 0;
  cursor:crosshair;
}
#bg-image{display:block;user-select:none;-webkit-user-drag:none;pointer-events:none}
#draw-canvas{
  position:absolute;top:0;left:0;cursor:crosshair;touch-action:none;
}
#dice-panel{
  position:fixed;right:16px;bottom:16px;
  background:#242424;border:1px solid #444;border-radius:8px;
  padding:12px;min-width:260px;max-width:340px;max-height:60vh;
  display:flex;flex-direction:column;
  box-shadow:0 4px 20px rgba(0,0,0,.6);z-index:20;
}
#dice-panel h3{margin:0 0 8px;color:#d4a95a;font-size:14px}
#dice-result{
  display:flex;flex-wrap:wrap;gap:6px;overflow-y:auto;
  padding:4px 0;flex:1;
}
.die{
  display:inline-flex;align-items:center;justify-content:center;
  min-width:34px;height:34px;padding:0 8px;
  background:#1a1a1a;border:2px solid #444;border-radius:6px;
  font-weight:bold;font-size:16px;color:#e0e0e0;
}
.die.high{border-color:#5ae05a;color:#5ae05a;background:#1a2a1a}
#dice-sum{
  margin-top:8px;padding-top:8px;border-top:1px solid #333;
  font-size:13px;color:#aaa;
}
#dice-sum b{color:#d4a95a;font-size:15px}
#hint{
  position:fixed;top:64px;left:12px;background:#242424;
  border:1px solid #333;border-radius:6px;padding:6px 10px;
  font-size:11px;color:#888;z-index:5;max-width:340px;
}
</style>
</head>
<body>

<div id="toolbar">
  <button id="btn-upload">Загрузить файл</button>
  <input type="file" id="file-input" accept="image/*,.json" style="display:none">
  <button class="secondary" id="btn-clear">Очистить рисунок</button>
  <label>Размер:</label>
  <input type="number" id="brush-size" min="1" max="50" value="4">
  <div class="colors" id="colors"></div>
  <button class="secondary" id="btn-eraser">Ластик</button>
  <span style="flex:1"></span>
  <label>Кубы к6:</label>
  <input type="number" id="dice-count" min="1" max="100" value="1">
  <button id="btn-roll">Бросить</button>
</div>

<div id="board">
  <div id="drop-zone">Перетащите сюда картинку или JSON чарлиста</div>
  <div id="canvas-wrap">
    <img id="bg-image" alt="">
    <canvas id="draw-canvas"></canvas>
  </div>
</div>

<div id="hint">Перетащите картинку или JSON от чарлиста. Рисуйте мышью. Ctrl+Z — отменить штрих.</div>

<div id="dice-panel">
  <h3>Результаты броска</h3>
  <div id="dice-result"><span style="color:#666;font-size:12px">Ещё не бросали</span></div>
  <div id="dice-sum"></div>
</div>

<script>
// ===== Цвета =====
const COLORS = ['#e05a5a','#5ae05a','#5a9ae0','#e0d45a','#e05ae0','#ffffff','#000000'];
const colorsBox = document.getElementById('colors');
COLORS.forEach((c,i)=>{
  const b = document.createElement('button');
  b.className = 'color-btn' + (i===0?' active':'');
  b.style.background = c;
  b.dataset.color = c;
  b.onclick = ()=>{
    currentColor = c;
    eraserMode = false;
    document.querySelectorAll('.color-btn').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
  };
  colorsBox.appendChild(b);
});
let currentColor = COLORS[0];
let eraserMode = false;

// ===== Кубы =====
const diceBtn = document.getElementById('btn-roll');
const diceResult = document.getElementById('dice-result');
const diceSum = document.getElementById('dice-sum');
diceBtn.onclick = ()=>{
  const n = Math.max(1, Math.min(100, parseInt(document.getElementById('dice-count').value)||1));
  const rolls = [];
  for(let i=0;i<n;i++) rolls.push(1+Math.floor(Math.random()*6));
  const sum = rolls.reduce((a,b)=>a+b,0);
  diceResult.innerHTML = rolls.map(r=>`<span class="die ${r>=5?'high':''}">${r}</span>`).join('');
  diceSum.innerHTML = `Кубов: <b>${n}</b> · Сумма: <b>${sum}</b> · Мин: <b>${Math.min(...rolls)}</b> · Макс: <b>${Math.max(...rolls)}</b>`;
};

// ===== Доска =====
const board = document.getElementById('board');
const dropZone = document.getElementById('drop-zone');
const wrap = document.getElementById('canvas-wrap');
const bgImg = document.getElementById('bg-image');
const canvas = document.getElementById('draw-canvas');
const ctx = canvas.getContext('2d');
const brushInput = document.getElementById('brush-size');
const fileInput = document.getElementById('file-input');
document.getElementById('btn-upload').onclick = ()=>fileInput.click();

let history = [];
let isDrawing = false;
let lastX = 0, lastY = 0;
let mode = 'empty'; // 'image' | 'json'

function fitWrap(){
  const bw = board.clientWidth, bh = board.clientHeight;
  const iw = canvas.width || 1;
  const ih = canvas.height || 1;
  const scale = Math.min(bw/iw, bh/ih, 1);
  const dw = iw*scale, dh = ih*scale;
  wrap.style.width = dw+'px';
  wrap.style.height = dh+'px';
  wrap.style.left = ((bw-dw)/2)+'px';
  wrap.style.top = ((bh-dh)/2)+'px';
  bgImg.style.width = dw+'px';
  bgImg.style.height = dh+'px';
  canvas.style.width = dw+'px';
  canvas.style.height = dh+'px';
}

function resetCanvas(w, h){
  canvas.width = w;
  canvas.height = h;
  ctx.clearRect(0,0,w,h);
  history = [];
}

// ===== Загрузка картинки =====
function loadImage(src){
  const im = new Image();
  im.onload = ()=>{
    bgImg.src = src;
    bgImg.onload = ()=>{
      dropZone.style.display = 'none';
      mode = 'image';
      resetCanvas(bgImg.naturalWidth, bgImg.naturalHeight);
      fitWrap();
    };
  };
  im.onerror = ()=>alert('Не удалось загрузить картинку');
  im.src = src;
}

// ===== Загрузка JSON чарлиста =====
// Импортируем данные из чарлиста, рисуем текстом на canvas как фон
const ATTRS={SIL:'СИЛ',TEL:'ТЕЛ',LVK:'ЛВК',INT:'ИНТ',MDR:'МДР',HAR:'ХАР'};
const SKILLS={
  blades:'Клинки',blunt:'Дробящее',axes:'Топоры',unarmed:'Безоружный бой',
  staves:'Посохи',thrown:'Метательное',polearms:'Древковое',bows:'Луки',
  crossbows:'Арбалеты',dualwield:'Парное оружие',evocation:'Воплощение',
  necromancy:'Некромантия',transmutation:'Трансмутация',illusion:'Иллюзия',
  enchantment:'Очарование',divination:'Прорицание',abjuration:'Ограждение',
  conjuration:'Созидание',defense:'Защита',persuasion:'Убеждение',
  survival:'Выживание',perception:'Внимательность',lore:'Начитанность',
  stealth:'Скрытность',sleight:'Сноровка',improvisation:'Импровизация',qi:'Ци'
};
const SKILL_ATTR={
  blades:['SIL','LVK'],blunt:'SIL',axes:'SIL',unarmed:['SIL','LVK'],staves:'LVK',
  thrown:'LVK',polearms:'LVK',bows:'LVK',crossbows:'LVK',dualwield:['SIL','LVK'],
  evocation:'INT',necromancy:'MDR',transmutation:'INT',illusion:'HAR',
  enchantment:'HAR',divination:'MDR',abjuration:'MDR',conjuration:'MDR',
  defense:null,persuasion:'HAR',survival:'MDR',perception:'MDR',lore:'INT',
  stealth:'LVK',sleight:'LVK',improvisation:'SIL',qi:'MDR'
};
const CLASSES_NAMES={
  alchemist:'Алхимик',bard:'Бард',barbarian:'Варвар',fighter:'Воин',wizard:'Волшебник',
  druid:'Друид',cleric:'Жрец',monk:'Монах',paladin:'Паладин',ranger:'Следопыт',
  sorcerer:'Чародей',rogue:'Плут',magus:'Магос'
};
const RACE_NAMES={
  human:'Человек',dwarf:'Дварф',gnome:'Гном',elf:'Эльф',halfling:'Полурослик',
  halfelf:'Полуэльф',halforc:'Полуорк',aasimar:'Аасимар',tiefling:'Тифлинг'
};
const GENDER_NAMES={male:'Мужской',female:'Женский','':'—'};
const PRIORITY_MONEY={A:40,B:70,C:150,D:270};

function getAttrValue(a, attrs){
  if(!a) return 0;
  if(Array.isArray(a)) return Math.max(...a.map(x=>attrs[x]||1));
  return attrs[a]||1;
}
function getAttrLabel(a){
  if(!a) return '—';
  if(Array.isArray(a)) return a.map(x=>ATTRS[x]).join('/');
  return ATTRS[a];
}

function buildJsonLines(data){
  const lines = [];
  lines.push('════════ ЧАРЛИСТ ════════');
  lines.push('');
  lines.push('【 ПЕРСОНАЖ 】');
  lines.push(`Имя: ${data.name||'—'}`);
  lines.push(`Пол: ${GENDER_NAMES[data.gender]||'—'}`);
  const race = RACE_NAMES[data.race]||data.race||'—';
  lines.push(`Раса: ${race}${data.subrace?' ('+data.subrace+')':''}`);
  lines.push(`Класс: ${CLASSES_NAMES[data.class]||data.class||'—'}`);
  if(data.priority) lines.push(`Приоритет: ${data.priority}`);
  lines.push('');

  lines.push('【 АТРИБУТЫ 】');
  const attrs = data.attrs||{};
  for(const k in ATTRS) lines.push(`  ${ATTRS[k]}: ${attrs[k]||1}`);
  lines.push('');

  lines.push('【 НАВЫКИ 】');
  const skills = data.skills||{};
  const ids = Object.keys(skills).filter(id=>skills[id]>0);
  if(!ids.length) lines.push('  —');
  else ids.sort().forEach(id=>{
    const v = skills[id];
    const a = getAttrValue(SKILL_ATTR[id], attrs);
    const total = v + a;
    lines.push(`  ${SKILLS[id]||id} (${getAttrLabel(SKILL_ATTR[id])}): ${v} → ${total}d6`);
  });
  lines.push('');

  lines.push('【 ЗАКЛИНАНИЯ 】');
  const spells = data.spells||{};
  const spellIds = Object.keys(spells).filter(id=>spells[id]);
  if(!spellIds.length) lines.push('  —');
  else spellIds.forEach(id=>lines.push(`  • ${id}`));
  lines.push('');

  lines.push('【 СНАРЯЖЕНИЕ 】');
  const cart = data.cart||[];
  if(!cart.length) lines.push('  —');
  else cart.forEach(c=>{
    let s = `  • ${c.name||c.id}`;
    if(c.sharp) s += ` [+${c.sharp} заточка]`;
    if(c.reinf) s += ` [+${c.reinf} укрепление]`;
    lines.push(s);
  });
  lines.push('');

  const tel = attrs.TEL||1;
  lines.push('【 ИТОГИ 】');
  lines.push(`  Здоровье: ${10+tel*2}`);
  lines.push(`  Деньги заработано: ${data.moneyEarned||0}`);
  lines.push('');

  if(data.notepad){
    const tabs={bio:'Предыстория',notes:'Заметки',quests:'Квесты'};
    for(const t in tabs){
      if(data.notepad[t] && data.notepad[t].trim()){
        lines.push(`【 ${tabs[t]} 】`);
        lines.push(data.notepad[t].trim());
        lines.push('');
      }
    }
  }
  lines.push('════════════════════════');
  return lines;
}

function loadJson(data){
  // создаём canvas нужного размера
  const lines = buildJsonLines(data);
  // ширина/высота под текст
  const W = 900;
  const lineH = 22;
  const padding = 30;
  const H = Math.max(400, padding*2 + lines.length*lineH);

  resetCanvas(W, H);
  mode = 'json';
  dropZone.style.display = 'none';

  // фон
  ctx.fillStyle = '#1a1a1a';
  ctx.fillRect(0,0,W,H);

  // текст
  ctx.font = '16px monospace';
  ctx.fillStyle = '#e0e0e0';
  ctx.textBaseline = 'top';
  let y = padding;
  for(const line of lines){
    // подсветка заголовков
    if(line.startsWith('【') || line.startsWith('════')){
      ctx.fillStyle = '#d4a95a';
    } else {
      ctx.fillStyle = '#e0e0e0';
    }
    ctx.fillText(line, padding, y);
    y += lineH;
  }

  // убираем <img> (он не нужен)
  bgImg.src = '';
  bgImg.style.display = 'none';

  fitWrap();
  // снова показываем img (на случай, если потом загрузят картинку)
  bgImg.style.display = 'block';
  bgImg.src = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
  bgImg.style.width = '0px';
  bgImg.style.height = '0px';
}

// ===== Автоопределение типа файла =====
function handleFile(f){
  if(f.type.startsWith('image/')){
    const reader = new FileReader();
    reader.onload = ev=>loadImage(ev.target.result);
    reader.readAsDataURL(f);
    return;
  }
  if(f.type === 'application/json' || f.name.toLowerCase().endsWith('.json')){
    const reader = new FileReader();
    reader.onload = ev=>{
      try{
        const data = JSON.parse(ev.target.result);
        if(!data || typeof data !== 'object'){
          alert('Не похоже на JSON чарлиста');
          return;
        }
        loadJson(data);
      }catch(e){
        alert('Ошибка чтения JSON: '+e.message);
      }
    };
    reader.readAsText(f);
    return;
  }
  alert('Неподдерживаемый тип файла: '+(f.type||'неизвестно'));
}

fileInput.onchange = e=>{
  const f = e.target.files[0];
  if(f) handleFile(f);
};

// drag & drop
['dragenter','dragover'].forEach(ev=>{
  board.addEventListener(ev, e=>{e.preventDefault();dropZone.classList.add('dragover');});
});
['dragleave','drop'].forEach(ev=>{
  board.addEventListener(ev, e=>{e.preventDefault();dropZone.classList.remove('dragover');});
});
board.addEventListener('drop', e=>{
  const f = e.dataTransfer.files[0];
  if(f) handleFile(f);
});

// вставка из буфера
document.addEventListener('paste', e=>{
  for(const it of e.clipboardData.items){
    if(it.type.startsWith('image/')){
      const f = it.getAsFile();
      handleFile(f);
      break;
    }
  }
});

// ===== Рисование =====
function getPos(e){
  const r = canvas.getBoundingClientRect();
  const scaleX = canvas.width / r.width;
  const scaleY = canvas.height / r.height;
  return {
    x: (e.clientX - r.left) * scaleX,
    y: (e.clientY - r.top) * scaleY
  };
}

function saveHistory(){
  if(history.length >= 30) history.shift();
  history.push(ctx.getImageData(0,0,canvas.width,canvas.height));
}

function brushSize(){
  return Math.max(1, Math.min(50, parseInt(brushInput.value)||4));
}

canvas.addEventListener('pointerdown', e=>{
  if(e.button !== 0) return;
  isDrawing = true;
  canvas.setPointerCapture(e.pointerId);
  saveHistory();
  const p = getPos(e);
  lastX = p.x; lastY = p.y;
  ctx.beginPath();
  ctx.arc(p.x, p.y, brushSize()/2, 0, Math.PI*2);
  if(eraserMode){
    ctx.globalCompositeOperation = 'destination-out';
    ctx.fillStyle = 'rgba(0,0,0,1)';
  } else {
    ctx.globalCompositeOperation = 'source-over';
    ctx.fillStyle = currentColor;
  }
  ctx.fill();
});

canvas.addEventListener('pointermove', e=>{
  if(!isDrawing) return;
  const p = getPos(e);
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  ctx.lineWidth = brushSize();
  if(eraserMode){
    ctx.globalCompositeOperation = 'destination-out';
    ctx.strokeStyle = 'rgba(0,0,0,1)';
  } else {
    ctx.globalCompositeOperation = 'source-over';
    ctx.strokeStyle = currentColor;
  }
  ctx.beginPath();
  ctx.moveTo(lastX, lastY);
  ctx.lineTo(p.x, p.y);
  ctx.stroke();
  lastX = p.x; lastY = p.y;
});

['pointerup','pointercancel','pointerleave'].forEach(ev=>{
  canvas.addEventListener(ev, ()=>{isDrawing=false;});
});

document.addEventListener('keydown', e=>{
  if((e.ctrlKey||e.metaKey) && e.key.toLowerCase()==='z'){
    e.preventDefault();
    if(history.length) ctx.putImageData(history.pop(),0,0);
  }
});

document.getElementById('btn-clear').onclick = ()=>{
  if(!confirm('Очистить рисунок?')) return;
  saveHistory();
  ctx.clearRect(0,0,canvas.width,canvas.height);
};

document.getElementById('btn-eraser').onclick = ()=>{
  eraserMode = !eraserMode;
  document.querySelectorAll('.color-btn').forEach(x=>x.classList.remove('active'));
  if(!eraserMode){
    currentColor = COLORS[0];
    document.querySelector('.color-btn').classList.add('active');
  }
};

window.addEventListener('resize', ()=>{ if(mode!=='empty') fitWrap(); });
</script>
</body>
</html>
